# Prometheus picks up every ServiceMonitor in every namespace; no labels needed.
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: {{ service_name }}
spec:
  selector:
    matchLabels: { app.kubernetes.io/name: {{ service_name }} }
  endpoints:
    - { port: http, path: /metrics, interval: 30s }
